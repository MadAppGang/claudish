#!/bin/sh
# harness.binary for this Bench: THIS worktree's built claudish
# (packages/cli/dist/index.js, the output of `bun run build`), never the
# claudish on PATH. The path is derived from this file's own location, so a
# run cannot pick up a global install by accident.
#
# Before handing over it writes claudish-provenance.txt into the workspace
# (the agent's cwd); the `provenance` Check reads it back, so the report
# records which build ran. It then adds the debug-log flags every Check that
# reads logs/claudish_*.log depends on, and `-q`, which returns before
# claudish's update prompt (its "nobody can answer" test is
# process.stdin.isTTY, which is true under magmux).
set -eu
here=$(cd "$(dirname "$0")" && pwd)
root=$(cd "$here/../../.." && pwd)
dist="$root/packages/cli/dist/index.js"
{
  echo "dist=$dist"
  echo "version=$(bun "$dist" --version 2>/dev/null | head -n 1)"
  echo "head=$(git -C "$root" rev-parse HEAD 2>/dev/null || echo unknown)"
  echo "dist_mtime=$(stat -f %Sm -t %Y-%m-%dT%H:%M:%S "$dist")"
} > claudish-provenance.txt
exec bun "$dist" --debug-claudish --log-level debug -q "$@"
