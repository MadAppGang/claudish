#!/bin/sh
# Starts the claudish build in ~/.bench-compaction/build with compaction on,
# for the variant claudish-compaction. The arguments are those of
# claudish-unattended (--quiet -y) plus --compaction and --debug-claudish
# (claudish's own debug log; a bare --debug goes on to Claude Code). The config,
# with the key compaction signs with, is the run's ~/.claudish/config.json,
# written by tools/claudish-compaction/start.sh. No --config: claudish exports
# a --config path to Claude Code as CLAUDISH_CONFIG.
#
# Before claudish starts:
#   - the launcher's own environment must hold no ANTHROPIC_API_KEY. The key
#     reaches claudish only through the config file, so Claude Code cannot
#     inherit it from here. If one is set, the launcher stops with exit 1.
#   - the SHA-256 of the bundle goes to the launch log, because the build's
#     --version does not tell builds apart.
#   - ./logs, where --debug-claudish writes claudish_<timestamp>.log, becomes a link
#     into ~/.bench-out, so the debug log outlives an errored trial.
#
# A watcher then waits for the Claude Code process that claudish starts and
# reads its environment with `ps eww`. It writes one label, never a value:
# AGENT_ENV_KEY_UNSET, AGENT_ENV_KEY_PLACEHOLDER (claudish's own placeholder)
# or AGENT_ENV_KEY_SET (any other value).
set -u
dir="$HOME/.bench-compaction"
# The process id keeps two starts in the same second apart: madbench starts
# the binary once to probe it before the session.
live="$HOME/.bench-out/claudish-compaction-launch-$(date +%Y%m%dT%H%M%S)-$$"
mkdir -p "$live/debug"
# ~/.bench-out is shared by all trials; evidence.sh finds this trial's folder here.
echo "$live" >"$dir/launch-dir"
note() { echo "$*" >>"$live/launch.log"; }

n=$(env | grep -c '^ANTHROPIC_API_KEY=')
note "launch: ANTHROPIC_API_KEY entries in the launcher environment: $n"
if [ "$n" -ne 0 ]; then
  echo "claudish-compaction: ANTHROPIC_API_KEY is set in the launcher environment; stopping" >&2
  exit 1
fi
note "launch: $# arguments, the first: ${1:-none}"
# The build is a compiled claudish executable, which carries its
# dependencies, or a folder with index.js (the refusing default). A JS bundle
# from `bun run build` does not run here: it loads @opentui and react from a
# node_modules beside it.
if [ -f "$dir/build" ]; then
  chmod +x "$dir/build"
  build="$dir/build"
  set -- "$build" --quiet -y --compaction --debug-claudish "$@"
else
  build="$dir/build/index.js"
  set -- bun "$build" --quiet -y --compaction --debug-claudish "$@"
fi
note "launch: build $build sha256 $(shasum -a 256 "$build" | cut -d' ' -f1)"
note "launch: cwd $(pwd)"
if [ ! -e logs ]; then
  ln -s "$live/debug" logs
  note "launch: ./logs -> $live/debug"
fi

placeholder="sk-ant-api03-placeholder-not-used-proxy-handles-auth-with-openrouter-key-xxxxxxxxxxxxxxxxxxxxx"
watch_agent_env() {
  i=0
  while [ "$i" -lt 600 ]; do
    pid=$(pgrep -f -- "--add-dir $HOME/.claudish/compaction/" | head -1)
    if [ -n "$pid" ]; then
      found=$(ps eww -o command= -p "$pid" | grep -o ' ANTHROPIC_API_KEY=[^ ]*' | head -1)
      if [ -z "$found" ]; then
        label=AGENT_ENV_KEY_UNSET
      elif [ "$found" = " ANTHROPIC_API_KEY=$placeholder" ]; then
        label=AGENT_ENV_KEY_PLACEHOLDER
      else
        label=AGENT_ENV_KEY_SET
      fi
      config=$(ps eww -o command= -p "$pid" | grep -c ' CLAUDISH_CONFIG=')
      note "agent-env: pid $pid $label CLAUDISH_CONFIG_present=$config"
      return
    fi
    i=$((i + 1))
    sleep 1
  done
  note "agent-env: AGENT_ENV_UNKNOWN: no Claude Code process with the compaction --add-dir in 600 s"
}
watch_agent_env &

exec "$@"
