# Smoke test results
packages/cli/results/*.json
.worktrees

# Pester NUnit output written by a manual/CI `Invoke-Pester -OutputFile testResults.xml`
# at the repo root. Same rationale as __pycache__ below: an untracked artifact made
# check_clean_cycle_exit report a dirty tree every cycle, which trains an operator to
# ignore dirt.
testResults.xml

# Model validation
validation/

# Added by claudeup
.mnemex/
gtd/sessions/
.agents/

# Diagnostic capture (temporary, activated via CLAUDISH_CAPTURE_DIR env)
capture/

# Session artifacts (traces, deploy notes, monitoring scripts)
trace-*.json
kv-cache-traces.md
monitor-traffic.sh
deploy-notes-*.md

# Python bytecode from the scripts/ analysis organs (traffic-*, *-trend.py, lane-matrix.py).
# Untracked __pycache__ made every cycle report a dirty tree, which trains an operator
# to ignore dirt -- and install-sidecar.ps1 -Force decides what it may hard-reset from
# exactly this signal.
__pycache__/
*.pyc

# #175 strict-runner per-machine baseline (systematic fail population is machine-local)
.test-strict-baseline.json

# Agent scratchpad accidents (global proposal 09/10, CoursIA-3 amendment): a
# script that resolves a temp path to the CWD leaves `scratchpad_*` behind, and
# a mangled absolute path (separators stripped) lands as a file NAMED like the
# path — measured 29.3 MB of those at a repo root, invisible to every guard
# because no destructive command ever ran. Two lines catch both families.
scratchpad_*
C:Users*

# Session-local scratch dir per the same proposal (never commit, never in the
# Claude dirs)
.tmp/
