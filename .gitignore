# Dependencies
node_modules/

# Build output
dist/
build/

# Environment files — any shape: the 19/09 rogue-relay evidence file
# (.env.rogue-relay-20260919) sat untracked at the root because only `.env`
# exactly was ignored (mandate 19/10). Tracked examples stay tracked.
.env*
!.env.example
!.env.*.example

# Machine-local MCP config (.mcp.json can carry credentials; never commit)
.mcp.json

# Playwright MCP artifacts (snapshots, console CSV exports)
.playwright-mcp/

# Machine-local compose overrides (hub-only binds, never shared)
docker-compose.override.yml

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

