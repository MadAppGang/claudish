# claudish sidecar — per-machine .env
#
# Copy to `.env` next to docker-compose.yml on a SIDECAR machine, then:
#   docker compose up -d --build
#
# The hub (po-2023) needs NONE of this: every value below defaults to the hub's
# current setup, so `docker compose up -d` with no .env keeps the hub unchanged.
#
# NEVER commit a filled-in .env — CLAUDISH_PROXY_KEY is a secret.

# --- Host wiring -------------------------------------------------------------

# Profile dir holding config.json (API keys, routing, profiles). Mounted read-only.
CLAUDISH_CONFIG_DIR=C:\Users\<user>\.claudish

# Host port to publish. 3000 is taken on some machines (ai-01) — pick a free one.
CLAUDISH_HOST_PORT=3001

# Container name — only needs changing if you run more than one on a host.
CLAUDISH_CONTAINER_NAME=claudish-sidecar

# Capture dir (host side). Keep capture ON: in NOMINAL mode the relay path writes
# nothing (the hub captures centrally), so any file that DOES appear here is by
# construction an AUTONOMOUS-mode outage capture — the trail that
# reconcile-outage-captures.ps1 packs and merges back into the hub's archives.
# Sidecars have no nightly compaction job, so run that reconciliation after an
# outage rather than blinding yourself pre-emptively.
CLAUDISH_CAPTURE_HOST_DIR=.\captures
# Leave UNSET to capture. Set it empty (CLAUDISH_CAPTURE_DIR=) only on a
# disk-starved host — that silently destroys the outage-reconciliation trail.
#CLAUDISH_CAPTURE_DIR=

# --- Relay -------------------------------------------------------------------

# Shared cluster key. Same value as the `x-proxy-key` header in the machine's
# ~/.claude/settings.json (ANTHROPIC_CUSTOM_HEADERS). Read it, never print it.
CLAUDISH_PROXY_KEY=

# Hub URL. Unset => this container IS the hub. Set => sidecar:
#   LAN (po-2024, po-2026, ai-01) : http://192.168.0.46:3000
#   WAN (po-2025, web1)           : https://models.myia.io
CLAUDISH_RELAY_UPSTREAM=http://192.168.0.46:3000

# 1 on WAN externals only (po-2025, web1). Leave empty on LAN.
CLAUDISH_RELAY_COMPRESS=

# Leak-policy backstop: 1 on EVERY machine except ai-01, which is the only one
# authorized for native Anthropic models.
CLAUDISH_NO_ANTHROPIC=1
