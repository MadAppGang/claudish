{
  "name": "claudish",
  "version": "14.5.1",
  "description": "Run Claude Code with any model - OpenRouter, Ollama, LM Studio & local models",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./hooks": {
      "types": "./dist/hooks.d.ts",
      "import": "./dist/hooks.js"
    }
  },
  "bin": {
    "claudish": "bin/claudish.cjs"
  },
  "scripts": {
    "dev": "bun --no-env-file run src/index.ts",
    "dev:mcp": "bun --no-env-file run src/index.ts --mcp",
    "dev:grok": "bun --no-env-file run src/index.ts --interactive --model x-ai/grok-code-fast-1",
    "dev:grok:debug": "bun --no-env-file run src/index.ts --interactive --debug --log-level info --model x-ai/grok-code-fast-1",
    "dev:info": "bun --no-env-file run src/index.ts --interactive --monitor",
    "build": "bun run scripts/generate-version.ts && bun run scripts/generate-hooks-dts.ts && bun build src/index.ts --outdir dist --target bun --external '@opentui/core' --external '@opentui/core-*' --external '@opentui/react' --external react --external 'react/*' && chmod +x dist/index.js && bun run build:hooks",
    "build:hooks": "bun build src/hooks/public.ts --outfile dist/hooks.js --target bun && tsc -p tsconfig.hooks.json && mv dist/.hooks-types/public.d.ts dist/hooks.d.ts && rm -rf dist/.hooks-types",
    "build:binary": "bun run scripts/generate-version.ts && bun run scripts/generate-hooks-dts.ts && bun build src/index.ts --compile --no-compile-autoload-dotenv --outfile claudish",
    "typecheck": "tsc --noEmit && bun run scripts/typecheck-blind.ts",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "bun test",
    "smoke": "bun run scripts/smoke-test.ts"
  },
  "dependencies": {
    "@1password/sdk": "0.4.1-beta.1",
    "@inquirer/prompts": "^8.0.1",
    "@inquirer/search": "^4.0.1",
    "@jitl/quickjs-singlefile-mjs-release-sync": "^0.32.0",
    "@modelcontextprotocol/sdk": "^1.27.0",
    "@opentui/core": "^0.1.107",
    "@opentui/react": "^0.1.107",
    "dotenv": "^17.2.3",
    "quickjs-emscripten-core": "^0.32.0",
    "react": "^19.2.4",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/bun": "latest",
    "@types/react": "^19.2.14",
    "bun-types": "^1.3.6",
    "typescript": "^5.9.3"
  },
  "files": ["dist/", "bin/", "native/mtm/mtm-*", "AI_AGENT_GUIDE.md", "skills/"],
  "engines": {
    "node": ">=18.0.0",
    "bun": ">=1.0.0"
  },
  "preferGlobal": true,
  "keywords": [
    "claude",
    "claude-code",
    "openrouter",
    "proxy",
    "cli",
    "mcp",
    "model-context-protocol",
    "ai"
  ],
  "optionalDependencies": {
    "@claudish/magmux-darwin-arm64": "6.7.0",
    "@claudish/magmux-darwin-x64": "6.7.0",
    "@claudish/magmux-linux-arm64": "6.7.0",
    "@claudish/magmux-linux-x64": "6.7.0"
  },
  "author": "Jack Rudenko <i@madappgang.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MadAppGang/claudish"
  }
}
