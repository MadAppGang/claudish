# The ONE magmux pin, read by test.yml (the pane suites run against it) and release.yml
# (the binaries ship it), so the magmux that ships is the magmux that was tested.
# Bump the tag and all four checksums together, deliberately, after the pane suites
# pass against the new release. The sums are copied from the release's checksums.txt
# and verified independently of it: a replaced asset or a moved tag fails the download.
MAGMUX_TAG=v0.18.0
MAGMUX_SHA256_darwin_amd64=86aabaa6b19ea149b81994779eae210320a619d193ad04bce76ae094ef6352fb
MAGMUX_SHA256_darwin_arm64=9b4d8d518c03368dd8d2a0b25a220987f4341fef4f0cd753845bcb2be730650e
MAGMUX_SHA256_linux_amd64=3d0c2d20fcf87cd310c29fbcdb1a259e3a3da89e0903c6ff0592ae0a670cc33c
MAGMUX_SHA256_linux_arm64=d2f3c3b9c980b6d4303e6230268d7358d90c9b3724e592520b86a6db4c8ccf59
