# The ONE magmux pin, read by scripts/test-macos.ts (the pane suites run against it) and
# release.yml (the binaries ship it), so the magmux
# that ships is the magmux that was tested. Bump the tag and all four checksums together,
# deliberately, after `bun run test:macos` passes against the new release. The sums are copied from the release's checksums.txt
# and verified independently of it: a replaced asset or a moved tag fails the download.
MAGMUX_TAG=v0.20.5
MAGMUX_SHA256_darwin_amd64=a9d4c2d2ff6e4e65c85cc077db66f895b7ee55d0cd9724c8df4201dccfc207db
MAGMUX_SHA256_darwin_arm64=0bf12583def77e08b3c72959907d10e52edfb2003ca53150a53de1e42c0bb90f
MAGMUX_SHA256_linux_amd64=f3b3ca028fa5e785891c524ae1700abab68f4c3c62e0ea8087e0aed47f468990
MAGMUX_SHA256_linux_arm64=46138fffbc32acb89c602b7796dd35710e16d7ee6be43d6d4707b72df4f7e4b0
